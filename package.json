{
  "name": "tracefact",
  "version": "0.1.2",
  "description": "Evidence-first reliability reports and replay for coding and browser agents.",
  "type": "module",
  "bin": {
    "tracefact": "dist/cli.js",
    "tracefact-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./adapter-sdk": "./dist/adapters/sdk.js"
  },
  "files": [
    "dist",
    "schema",
    "web-dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts analyze examples/offline-demo.codex.jsonl --out demo-output --open false",
    "dataset:generate": "tsx scripts/generate-dataset.ts",
    "experiment": "tsx scripts/evaluate-detectors.ts",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "observability",
    "evaluation",
    "replay",
    "codex",
    "gemini-cli",
    "browser-use"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex0AI/tracefact.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
